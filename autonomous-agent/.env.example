# Copy to .env. Real environment variables override this file. Never commit .env.

# local | cloud | hybrid
AGENT_LLM_MODE=hybrid

# Local model (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Cloud model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limits
AGENT_MAX_TASK_SECONDS=900
AGENT_MAX_ACTIONS=40
AGENT_MAX_RETRIES=2
AGENT_MAX_REPLANS=2
AGENT_COMMAND_TIMEOUT=60

# Windows desktop: screen images and OCR are disabled unless explicitly enabled.
AGENT_DESKTOP_SCREENSHOTS=0
AGENT_DESKTOP_OCR=0
